ADDR = "0.0.0.0:8383"
DB_STRING = 'root:root@tcp(localhost)/authservice?parseTime=true&charset=utf8mb4&loc=UTC'
CORPORATE_DB_STRING = 'root:root@tcp(localhost)/corporate_db?parseTime=true&charset=utf8mb4&loc=UTC'
SESSION_TTL = "8h" # ("3h", "45m", "1h30m" и т.д.).
APP_ENV = development
COOKIE_DOMAIN = localhost
APP_BASE_URL = "http://localhost:5175"
# openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY = "CHANGE_ME_32_BYTE_BASE64_KEY"

# Несколько сайтов: раскомментируйте TENANTS и заполните настройки каждого.
# HTTP-прокси должен передавать исходный Host, а неизвестные Host отклонять.
# Для каждого сайта нужны отдельные auth и corporate базы данных.
# TENANTS = FIRST,SECOND
# TENANT_FIRST_HOST = sso.st29.ru
# TENANT_FIRST_DB_STRING = 'user:password@tcp(localhost:3306)/auth_first?parseTime=true&charset=utf8mb4&loc=UTC'
# TENANT_FIRST_CORPORATE_DB_STRING = 'user:password@tcp(localhost:3306)/corporate_first?parseTime=true&charset=utf8mb4&loc=UTC'
# TENANT_FIRST_COOKIE_DOMAIN = .st29.ru
# TENANT_FIRST_APP_BASE_URL = https://sso.st29.ru
# TENANT_FIRST_ALLOWED_ORIGINS = https://sso.st29.ru
# TENANT_SECOND_HOST = sso2.st29.ru
# TENANT_SECOND_DB_STRING = 'user:password@tcp(localhost:3306)/auth_second?parseTime=true&charset=utf8mb4&loc=UTC'
# TENANT_SECOND_CORPORATE_DB_STRING = 'user:password@tcp(localhost:3306)/corporate_second?parseTime=true&charset=utf8mb4&loc=UTC'
# Пустое значение создаёт host-only cookie, только для sso2.st29.ru.
# TENANT_SECOND_COOKIE_DOMAIN =
# TENANT_SECOND_APP_BASE_URL = https://sso2.st29.ru
# TENANT_SECOND_ALLOWED_ORIGINS = https://sso2.st29.ru
# Запросы к backend должны идти через соответствующий HOST (обычно reverse proxy).
# gRPC в многосайтовом режиме отключён.
